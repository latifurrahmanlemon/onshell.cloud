generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  DEVOPS
  DEVELOPER
  AUDITOR
}

enum HostType {
  SSH
  RDP
  VNC
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum CredentialKind {
  PASSWORD
  SSH_KEY
  RDP_PASSWORD
}

enum SessionProtocol {
  SSH
  SFTP
  RDP
  VNC
  TUNNEL
}

enum SessionStatus {
  PENDING
  ACTIVE
  CLOSED
  FAILED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  PADDLE
  SSL_COMMERZ
  MANUAL
}

enum AuthProvider {
  GOOGLE
}

enum ContactStatus {
  NEW
  OPEN
  RESOLVED
  SPAM
}

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AuthEventType {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  TWO_FACTOR_COMPLETED
}

enum AuthEventMethod {
  PASSWORD
  GOOGLE
  TWO_FACTOR
  /// Events with no credential of their own, such as sign-out.
  SESSION
}

enum EmailLogStatus {
  SENT
  FAILED
  /// SMTP is disabled, so the message was never handed to a provider.
  SKIPPED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String?
  avatarUrl           String?              @db.MediumText
  themePreference     Json?
  isPlatformAdmin     Boolean              @default(false)
  emailVerifiedAt     DateTime?
  twoFactorEnabled    Boolean              @default(false)
  /// Shareable referral code used by the growth/referral programme.
  referralCode        String?              @unique
  /// The user whose referral link produced this signup, when any.
  referredById        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         OrganizationMember[]
  sessions            Session[]
  snippets            Snippet[]
  refreshTokens       RefreshToken[]
  twoFactorSecret     TwoFactorSecret?
  passwordResetToken  PasswordResetToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  updatedSettings     AppSetting[]         @relation("SettingUpdatedBy")
  updatedSmtpSettings SmtpSetting[]        @relation("SmtpUpdatedBy")
  oauthAccounts       OAuthAccount[]
  referredBy          User?                @relation("UserReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]               @relation("UserReferral")
  aiThreads           AiThread[]
  handledContacts     ContactMessage[]     @relation("ContactHandledBy")
  visitorLogs         VisitorLog[]
  authEvents          AuthEventLog[]
  hostAccessGrants    HostAccessGrant[]    @relation("HostAccessSubject")
  grantedHostAccess   HostAccessGrant[]    @relation("HostAccessGrantedBy")

  @@index([referredById])
}

model Organization {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       OrganizationMember[]
  invitations   Invitation[]
  hosts         Host[]
  credentials   Credential[]
  sessions      Session[]
  auditLogs     AuditLog[]
  snippets      Snippet[]
  subscriptions Subscription[]
  usageRecords  UsageRecord[]
  aiThreads     AiThread[]
  hostAccessGrants HostAccessGrant[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String
  acceptedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Host {
  id             String          @id @default(cuid())
  organizationId String
  groupId        String?
  name           String
  type           HostType
  address        String
  port           Int
  username       String?
  environment    Environment
  notes          String?         @db.Text
  health         String          @default("unknown")
  /// The machine the gateway itself runs on. Sessions to it need no credential
  /// and never open a network connection — see lib/provisioning.ts. One row per
  /// organization, created on signup.
  isLocal        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group          HostGroup?      @relation(fields: [groupId], references: [id])
  tags           HostTag[]
  credentials    Credential[]
  sessions       Session[]
  snippets       Snippet[]
  sftpOperations SftpOperation[]
  rdpConnection  RdpConnection?
  tunnelRules    TunnelRule[]
  accessGrants   HostAccessGrant[]
}

model HostGroup {
  id             String @id @default(cuid())
  organizationId String
  name           String
  hosts          Host[]
}

model HostTag {
  id     String @id @default(cuid())
  name   String
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

/// Grants one member access to one host, or — when `allHosts` is set and
/// `hostId` is null — to every host in the organization. Absence of any
/// matching row denies access; see lib/host-access.ts for which roles the
/// table governs and which bypass it.
model HostAccessGrant {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  /// The granted host, or null on the single org-wide row.
  hostId         String?
  allHosts       Boolean      @default(false)
  /// Mirrors the grant target as a non-null key: `hostId`, or "*" for the
  /// org-wide row. MySQL treats NULLs as distinct, so a unique index over
  /// `hostId` alone could not stop a member collecting duplicate all-hosts
  /// rows. Always written together with `hostId`/`allHosts`.
  scopeKey       String
  /// Who granted it. Kept as null when that account is deleted so the audit
  /// trail survives the grantor.
  grantedById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("HostAccessSubject", fields: [userId], references: [id], onDelete: Cascade)
  host           Host?        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  grantedBy      User?        @relation("HostAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId, scopeKey])
  @@index([organizationId, userId])
  @@index([hostId])
  @@index([grantedById])
}

model Credential {
  id               String         @id @default(cuid())
  organizationId   String
  name             String
  kind             CredentialKind
  encryptedPayload String         @db.Text
  nonce            String
  authTag          String
  rotatedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hosts            Host[]
  sshKey           SSHKey?
}

model SSHKey {
  id             String     @id @default(cuid())
  credentialId   String     @unique
  fingerprint    String
  passphraseHint String?
  createdAt      DateTime   @default(now())
  credential     Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
}

model Session {
  id               String          @id @default(cuid())
  organizationId   String
  hostId           String
  userId           String
  protocol         SessionProtocol
  status           SessionStatus   @default(PENDING)
  gatewaySessionId String?
  startedAt        DateTime        @default(now())
  endedAt          DateTime?
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  host             Host            @relation(fields: [hostId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sftpOperations   SftpOperation[]
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String
  action         String
  targetType     String
  targetId       String?
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
}

model Snippet {
  id             String       @id @default(cuid())
  organizationId String
  ownerId        String
  hostId         String?
  name           String
  command        String       @db.Text
  scope          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  host           Host?        @relation(fields: [hostId], references: [id])
}

model SftpOperation {
  id        String   @id @default(cuid())
  sessionId String
  hostId    String
  operation String
  path      String   @db.Text
  status    String
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

model RdpConnection {
  id         String   @id @default(cuid())
  hostId     String   @unique
  width      Int?
  height     Int?
  colorDepth Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  host       Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

model TunnelRule {
  id        String   @id @default(cuid())
  hostId    String
  name      String
  localPath String   @db.Text
  targetUrl String   @db.Text
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model TwoFactorSecret {
  id              String   @id @default(cuid())
  userId          String   @unique
  encryptedSecret String   @db.Text
  nonce           String
  authTag         String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenHash])
}

model OAuthAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  email             String
  accessToken       String?      @db.Text
  refreshToken      String?      @db.Text
  expiresAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([email])
}

model Plan {
  id                    String         @id @default(cuid())
  code                  String         @unique
  name                  String
  description           String         @db.Text
  priceMonthlyCents     Int
  priceYearlyCents      Int
  currency              String         @default("USD")
  maxUsers              Int?
  maxHosts              Int?
  maxConcurrentSessions Int?
  auditRetentionDays    Int
  features              Json
  isActive              Boolean        @default(true)
  displayOrder          Int            @default(0)
  /// Free tier of the freemium funnel. Auto-assigned on signup, never charged.
  isFree                Boolean        @default(false)
  /// Renders as the "most popular" card on the public pricing grid.
  isFeatured            Boolean        @default(false)
  /// Short marketing badge shown on the pricing card, e.g. "Most popular".
  badge                 String?
  /// One-line marketing hook above the feature list.
  tagline               String?
  /// Paid-plan trial length in days. 0 disables the trial.
  trialDays             Int            @default(0)
  /// AI assistant messages included per calendar month. Null means unlimited.
  monthlyAiMessages     Int?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  subscriptions         Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  billingInterval        BillingInterval    @default(MONTHLY)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  cancelAt               DateTime?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id])
  invoices               Invoice[]
}

model Invoice {
  id                String       @id @default(cuid())
  subscriptionId    String
  amountCents       Int
  currency          String       @default("USD")
  status            String       @default("draft")
  providerInvoiceId String?      @unique
  hostedInvoiceUrl  String?      @db.Text
  paidAt            DateTime?
  dueAt             DateTime?
  createdAt         DateTime     @default(now())
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id             String       @id @default(cuid())
  organizationId String
  metric         String
  quantity       Int
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SmtpSetting {
  id                String   @id @default("global")
  host              String
  port              Int
  secure            Boolean  @default(true)
  username          String?
  encryptedPassword String?  @db.Text
  passwordNonce     String?
  passwordAuthTag   String?
  fromEmail         String
  fromName          String
  enabled           Boolean  @default(false)
  testRecipient     String?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedBy         User?    @relation("SmtpUpdatedBy", fields: [updatedById], references: [id])
}

model AppSetting {
  key         String   @id
  category    String
  value       Json
  isSecret    Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id])
}

model PaymentSetting {
  id                     String          @id @default(cuid())
  provider               PaymentProvider
  mode                   String          @default("test")
  publicKey              String?
  encryptedSecretKey     String?         @db.Text
  secretKeyNonce         String?
  secretKeyAuthTag       String?
  encryptedWebhookSecret String?         @db.Text
  webhookSecretNonce     String?
  webhookSecretAuthTag   String?
  enabled                Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([provider, mode])
}

/// Cloudflare Turnstile credentials for the public forms. The site key is public
/// and served to the browser; the secret key is encrypted with the master key.
model TurnstileSetting {
  id                    String   @id @default("global")
  siteKey               String?
  encryptedSecretKey    String?  @db.Text
  secretKeyNonce        String?
  secretKeyAuthTag      String?
  enabled               Boolean  @default(false)
  /// Per-form toggles so admins can protect signup but leave, say, login open.
  protectSignup         Boolean  @default(true)
  protectLogin          Boolean  @default(true)
  protectPasswordReset  Boolean  @default(true)
  protectContact        Boolean  @default(true)
  protectCheckout       Boolean  @default(true)
  protectNewsletter     Boolean  @default(true)
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// OpenAI credentials and behaviour for the in-product AI assistant.
model AiSetting {
  id                 String   @id @default("global")
  provider           String   @default("openai")
  model              String   @default("gpt-4o-mini")
  encryptedApiKey    String?  @db.Text
  apiKeyNonce        String?
  apiKeyAuthTag      String?
  baseUrl            String?
  systemPrompt       String   @db.Text
  temperature        Int      @default(20)
  maxOutputTokens    Int      @default(900)
  /// Fallback monthly per-user message cap when the plan does not set one.
  monthlyMessageCap  Int      @default(100)
  enabled            Boolean  @default(false)
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// One AI assistant conversation. Threads are scoped to an organization so
/// platform admins can review them without cross-tenant leakage.
model AiThread {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  title          String
  archivedAt     DateTime?
  lastMessageAt  DateTime     @default(now())
  messageCount   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AiMessage[]

  @@index([organizationId, lastMessageAt])
  @@index([userId, lastMessageAt])
}

model AiMessage {
  id           String   @id @default(cuid())
  threadId     String
  role         AiRole
  content      String   @db.Text
  model        String?
  promptTokens Int?
  outputTokens Int?
  createdAt    DateTime @default(now())
  thread       AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// A "Contact us" submission from the public site, reviewable in the admin panel.
model ContactMessage {
  id           String        @id @default(cuid())
  name         String
  email        String
  company      String?
  topic        String        @default("general")
  message      String        @db.Text
  status       ContactStatus @default(NEW)
  /// Internal-only notes; never returned to the submitter.
  adminNotes   String?       @db.Text
  ipAddress    String?
  userAgent    String?       @db.Text
  /// Set when a user was signed in at submit time, for support context.
  submittedById String?
  handledById  String?
  handledAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  handledBy    User?         @relation("ContactHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
}

/// Marketing email capture from the public site footer.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String    @default("footer")
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  ipAddress      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// One page view on the public site, written by POST /public/visit.
///
/// Deliberately not an AuditLog: audit rows are organization-scoped and require
/// an actor, while most visits are anonymous and belong to no tenant.
model VisitorLog {
  id        String   @id @default(cuid())
  /// Pathname only — query strings are dropped so the column stays indexable
  /// and cannot accumulate tokens passed in URLs.
  path      String
  referrer  String?  @db.Text
  /// Set when a session cookie accompanied the beacon. Kept on user deletion
  /// as null so traffic history stays intact.
  userId    String?
  ipAddress String?
  userAgent String?  @db.Text
  /// ISO 3166-1 alpha-2, when the edge/proxy supplies a geo header.
  country   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([userId, createdAt])
  @@index([country, createdAt])
}

/// Sign-in lifecycle events. Records the attempted email even when no account
/// matches, which is what makes failed-login review useful.
model AuthEventLog {
  id        String          @id @default(cuid())
  userId    String?
  email     String
  event     AuthEventType
  method    AuthEventMethod
  success   Boolean
  /// Short machine-readable cause on failure, e.g. "invalid_password".
  reason    String?
  ipAddress String?
  userAgent String?         @db.Text
  createdAt DateTime        @default(now())
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([email, createdAt])
}

/// Delivery record for every outbound email.
///
/// Subject and status only — bodies are never stored, because transactional
/// mail carries one-time codes and reset links.
model EmailLog {
  id                String         @id @default(cuid())
  recipient         String
  subject           String
  /// Template identifier, e.g. "password_reset" or "contact_notification".
  kind              String         @default("transactional")
  status            EmailLogStatus
  providerMessageId String?
  error             String?        @db.Text
  createdAt         DateTime       @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([recipient, createdAt])
  @@index([kind, createdAt])
}
