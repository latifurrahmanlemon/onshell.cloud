generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  DEVOPS
  DEVELOPER
  AUDITOR
}

enum HostType {
  SSH
  RDP
  VNC
  /// A customer's own machine, reached through the tunnel its agent holds open
  /// to the gateway rather than by dialling out. See docs/agent.md.
  AGENT
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum CredentialKind {
  PASSWORD
  SSH_KEY
  RDP_PASSWORD
}

enum SessionProtocol {
  SSH
  SFTP
  RDP
  VNC
  TUNNEL
}

enum SessionStatus {
  PENDING
  ACTIVE
  CLOSED
  FAILED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  PADDLE
  SSL_COMMERZ
  MANUAL
}

enum AuthProvider {
  GOOGLE
}

enum ContactStatus {
  NEW
  OPEN
  RESOLVED
  SPAM
}

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AuthEventType {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  TWO_FACTOR_COMPLETED
}

enum AuthEventMethod {
  PASSWORD
  GOOGLE
  TWO_FACTOR
  /// Events with no credential of their own, such as sign-out.
  SESSION
}

enum EmailLogStatus {
  SENT
  FAILED
  /// SMTP is disabled, so the message was never handed to a provider.
  SKIPPED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String?
  avatarUrl           String?              @db.MediumText
  themePreference     Json?
  isPlatformAdmin     Boolean              @default(false)
  emailVerifiedAt     DateTime?
  twoFactorEnabled    Boolean              @default(false)
  /// Shareable referral code used by the growth/referral programme.
  referralCode        String?              @unique
  /// The user whose referral link produced this signup, when any.
  referredById        String?
  /// The workspace this account was last looking at.
  ///
  /// A preference, never an authorization: every request re-reads the
  /// memberships and falls back if this one has gone. What it buys is that
  /// signing in again lands the person where they left off, instead of in
  /// whichever membership happens to be oldest — which for anyone who accepted
  /// an invitation to a second workspace is the wrong one.
  lastActiveOrganizationId String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         OrganizationMember[]
  sessions            Session[]
  snippets            Snippet[]
  refreshTokens       RefreshToken[]
  twoFactorSecret     TwoFactorSecret?
  passwordResetToken  PasswordResetToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  updatedSettings     AppSetting[]         @relation("SettingUpdatedBy")
  updatedSmtpSettings SmtpSetting[]        @relation("SmtpUpdatedBy")
  oauthAccounts       OAuthAccount[]
  referredBy          User?                @relation("UserReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]               @relation("UserReferral")
  lastActiveOrganization Organization?     @relation("UserLastActiveOrganization", fields: [lastActiveOrganizationId], references: [id], onDelete: SetNull)
  aiThreads           AiThread[]
  handledContacts     ContactMessage[]     @relation("ContactHandledBy")
  visitorLogs         VisitorLog[]
  authEvents          AuthEventLog[]
  hostAccessGrants    HostAccessGrant[]    @relation("HostAccessSubject")
  grantedHostAccess   HostAccessGrant[]    @relation("HostAccessGrantedBy")
  hostWorkspaces      HostWorkspace[]      @relation("HostWorkspaceCreatedBy")
  favoriteHosts       HostFavorite[]
  enrolledAgents      AgentDevice[]        @relation("AgentEnrolledBy")
  agentPairingCodes   AgentPairingCode[]   @relation("AgentPairingCreatedBy")
  desktopDevices      DesktopDevice[]

  @@index([referredById])
  @@index([lastActiveOrganizationId])
}

model Organization {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  /// Whether members may open sessions straight from the desktop app instead of
  /// through the gateway. On by default because it is the more private path —
  /// the bytes never touch our servers — but some teams need every byte through
  /// a relay they can inspect, and that decision belongs to the workspace.
  allowDirectConnect Boolean          @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       OrganizationMember[]
  invitations   Invitation[]
  hosts         Host[]
  credentials   Credential[]
  sessions      Session[]
  auditLogs     AuditLog[]
  snippets      Snippet[]
  subscriptions Subscription[]
  usageRecords  UsageRecord[]
  aiThreads     AiThread[]
  hostAccessGrants HostAccessGrant[]
  hostWorkspaces   HostWorkspace[]
  agentDevices     AgentDevice[]
  agentPairingCodes AgentPairingCode[]
  desktopDevices   DesktopDevice[]
  refreshTokens    RefreshToken[]
  lastActiveForUsers User[]           @relation("UserLastActiveOrganization")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String
  acceptedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Host {
  id             String          @id @default(cuid())
  organizationId String
  groupId        String?
  name           String
  type           HostType
  address        String
  port           Int
  username       String?
  environment    Environment
  notes          String?         @db.Text
  health         String          @default("unknown")
  /// The machine the gateway itself runs on. Sessions to it need no credential
  /// and never open a network connection — see lib/provisioning.ts. One row per
  /// organization, created on signup.
  isLocal        Boolean         @default(false)
  /// Backed by an enrolled machine running the Onshell Agent. Sessions to it
  /// need no credential and open no outbound connection — the machine is
  /// already connected to us. One row per device.
  isAgent        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  agentDevice    AgentDevice?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group          HostGroup?      @relation(fields: [groupId], references: [id])
  tags           HostTag[]
  credentials    Credential[]
  sessions       Session[]
  snippets       Snippet[]
  sftpOperations SftpOperation[]
  rdpConnection  RdpConnection?
  tunnelRules    TunnelRule[]
  accessGrants   HostAccessGrant[]
  workspaces     HostWorkspaceHost[]
  favorites      HostFavorite[]
}

/// One operator's pinned host.
///
/// Personal rather than shared: a favourite says how one person works, not
/// something about the estate, so two people can pin different halves of the
/// same fleet without arguing. Never widens access — routes read it behind
/// `accessibleHostFilter` like everything else, and a pin on a host whose grant
/// is later revoked simply stops being returned.
model HostFavorite {
  id        String   @id @default(cuid())
  userId    String
  hostId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  /// Pinning twice is the same as pinning once.
  @@unique([userId, hostId])
  /// Deleting a host cascades through this index instead of scanning the table.
  @@index([hostId])
}

model HostGroup {
  id             String @id @default(cuid())
  organizationId String
  name           String
  hosts          Host[]
}

model HostTag {
  id     String @id @default(cuid())
  name   String
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

/// Grants one member access to one host, or — when `allHosts` is set and
/// `hostId` is null — to every host in the organization. Absence of any
/// matching row denies access; see lib/host-access.ts for which roles the
/// table governs and which bypass it.
model HostAccessGrant {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  /// The granted host, or null on the single org-wide row.
  hostId         String?
  allHosts       Boolean      @default(false)
  /// Mirrors the grant target as a non-null key: `hostId`, or "*" for the
  /// org-wide row. MySQL treats NULLs as distinct, so a unique index over
  /// `hostId` alone could not stop a member collecting duplicate all-hosts
  /// rows. Always written together with `hostId`/`allHosts`.
  scopeKey       String
  /// Who granted it. Kept as null when that account is deleted so the audit
  /// trail survives the grantor.
  grantedById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("HostAccessSubject", fields: [userId], references: [id], onDelete: Cascade)
  host           Host?        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  grantedBy      User?        @relation("HostAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId, scopeKey])
  @@index([organizationId, userId])
  @@index([hostId])
  @@index([grantedById])
}

/// A named set of hosts opened together — the five app servers of one tier
/// become five terminal tabs in a single action. Shared across the organization
/// rather than owned privately, because the sets people want ("prod web tier")
/// are a property of the estate, not of one operator's browser.
///
/// Membership never widens access: routes list and store hosts through
/// `accessibleHostFilter`, so a member only ever sees the subset of a workspace
/// they already hold a grant for.
model HostWorkspace {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  /// Free prose about what the set is for and how to use it ("deploy order:
  /// canary first"). `@db.Text` because it is a note, not a label.
  description    String?             @db.Text
  /// Who saved it. Nulled rather than cascaded when that account is deleted so a
  /// team's shared set outlives the person who created it.
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?               @relation("HostWorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  hosts          HostWorkspaceHost[]

  /// One name per organization: two "prod web" workspaces are indistinguishable
  /// in the picker, and the collision is far more often a double-submit than an
  /// intent. Surfaces to the client as 409 via handleRouteError.
  @@unique([organizationId, name])
  @@index([createdById])
}

/// Joins a workspace to a host. Written as an explicit join model rather than an
/// implicit many-to-many so the open order can be stored: "web-01 then web-02"
/// has to survive a reload, and an implicit relation table has no room for it.
model HostWorkspaceHost {
  id          String        @id @default(cuid())
  workspaceId String
  hostId      String
  /// Zero-based position the host opens in, so the tab order is the order the
  /// operator picked instead of whatever the database happens to return.
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  workspace   HostWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  host        Host          @relation(fields: [hostId], references: [id], onDelete: Cascade)

  /// A host appearing twice would open a duplicate terminal for no reason.
  @@unique([workspaceId, hostId])
  /// Deleting a host cascades through this index rather than table-scanning
  /// every workspace in the install.
  @@index([hostId])
}

/// A machine running the Onshell Agent.
///
/// Backed one-to-one by a `Host` row, which is what makes access control free:
/// `HostAccessGrant`, workspaces, tags, snippets and audit all keep working
/// without knowing an agent exists. See docs/agent.md.
model AgentDevice {
  id             String       @id @default(cuid())
  organizationId String
  hostId         String       @unique
  name           String
  /// Stable machine identifier, used to recognise a device re-enrolling after a
  /// reinstall so the host list does not accumulate duplicates. Spoofable by
  /// design and never trusted for authentication.
  fingerprint    String
  platform       String
  arch           String
  osVersion      String?
  agentVersion   String?
  hostname       String?
  /// SHA-256 of the long-lived device token. The token itself is shown once, at
  /// enrolment, and is exchanged for a short-lived connection JWT after that.
  tokenHash      String       @unique
  lastSeenAt     DateTime?
  /// Who paired it. Nulled rather than blocking if that person is deleted — the
  /// machine is still there and still legitimate; only the provenance is lost.
  enrolledById   String?
  /// Set when access is withdrawn. Revoked devices keep their row so the audit
  /// trail still names the machine that was reachable.
  revokedAt      DateTime?
  /// Policy, enforced by the agent on the machine itself.
  allowShell     Boolean      @default(true)
  allowFiles     Boolean      @default(true)
  /// Whether the person at the machine must approve a session before it starts.
  requireApproval Boolean     @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  host           Host         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  enrolledBy     User?        @relation("AgentEnrolledBy", fields: [enrolledById], references: [id], onDelete: SetNull)

  @@unique([organizationId, fingerprint])
  @@index([organizationId])
  @@index([enrolledById])
}

/// A copy of the desktop app that a member has signed in on.
///
/// Not an agent: an agent *serves* a machine's shell to the workspace, while
/// this *uses* the workspace from a machine. The reason it is a row at all is
/// the credential lease — direct connections put decrypted credential material
/// on somebody's laptop, and "which machines have been handed material, and can
/// I cut one off" has to be an answerable question.
///
/// Being enrolled is not what authorises a lease; the user's own access does.
/// The row is what makes the handout visible in the audit log and revocable
/// afterwards.
model DesktopDevice {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  name           String
  /// Stable machine identifier, so reinstalling the app does not accumulate a
  /// new row every launch. Spoofable by design and never trusted for auth.
  fingerprint    String
  platform       String
  appVersion     String?
  /// SHA-256 of the secret handed back at enrolment and presented on every
  /// lease request. Held in the machine's keychain, never written in the clear.
  secretHash     String       @unique
  lastSeenAt     DateTime?
  /// Set when the owner cuts the machine off. The row stays so the audit trail
  /// still names the device that held leases.
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per machine per person — two accounts on one laptop are two
  /// devices, because revoking one must not cut off the other.
  @@unique([userId, fingerprint])
  @@index([organizationId])
}

/// A short-lived code someone types into the agent to pair a machine.
///
/// The only moment a human transcribes a secret in this flow, which is why it
/// is single-use, expires in minutes, and is rate-limited on both ends.
model AgentPairingCode {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  codeHash       String       @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Cascade, unlike the device: an outstanding code belonging to someone who
  /// has been removed from the workspace must not stay redeemable.
  createdBy      User         @relation("AgentPairingCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdById])
  @@index([expiresAt])
}

model Credential {
  id               String         @id @default(cuid())
  organizationId   String
  name             String
  kind             CredentialKind
  encryptedPayload String         @db.Text
  nonce            String
  authTag          String
  rotatedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hosts            Host[]
  sshKey           SSHKey?
}

model SSHKey {
  id             String     @id @default(cuid())
  credentialId   String     @unique
  fingerprint    String
  passphraseHint String?
  createdAt      DateTime   @default(now())
  credential     Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
}

model Session {
  id               String          @id @default(cuid())
  organizationId   String
  hostId           String
  userId           String
  protocol         SessionProtocol
  status           SessionStatus   @default(PENDING)
  gatewaySessionId String?
  startedAt        DateTime        @default(now())
  endedAt          DateTime?
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  host             Host            @relation(fields: [hostId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sftpOperations   SftpOperation[]
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String
  action         String
  targetType     String
  targetId       String?
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
}

model Snippet {
  id             String       @id @default(cuid())
  organizationId String
  ownerId        String
  hostId         String?
  name           String
  command        String       @db.Text
  scope          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  host           Host?        @relation(fields: [hostId], references: [id])
}

model SftpOperation {
  id        String   @id @default(cuid())
  sessionId String
  hostId    String
  operation String
  path      String   @db.Text
  status    String
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

model RdpConnection {
  id         String   @id @default(cuid())
  hostId     String   @unique
  width      Int?
  height     Int?
  colorDepth Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  host       Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

model TunnelRule {
  id        String   @id @default(cuid())
  hostId    String
  name      String
  localPath String   @db.Text
  targetUrl String   @db.Text
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  /// Which of the user's workspaces this session is looking at.
  ///
  /// It lives on the session row rather than only in the access JWT because the
  /// clients call `/auth/refresh` on any 401 and on tab focus. An active
  /// organization that existed only in the token would be quietly reset by a
  /// background refresh, moving someone into another workspace mid-session with
  /// nothing on screen to explain it.
  ///
  /// Nullable: sessions issued before this column existed have no answer, and
  /// neither does a user with no membership at all.
  organizationId String?
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([organizationId])
}

model TwoFactorSecret {
  id              String   @id @default(cuid())
  userId          String   @unique
  encryptedSecret String   @db.Text
  nonce           String
  authTag         String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenHash])
}

model OAuthAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  email             String
  accessToken       String?      @db.Text
  refreshToken      String?      @db.Text
  expiresAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([email])
}

model Plan {
  id                    String         @id @default(cuid())
  code                  String         @unique
  name                  String
  description           String         @db.Text
  priceMonthlyCents     Int
  priceYearlyCents      Int
  currency              String         @default("USD")
  maxUsers              Int?
  maxHosts              Int?
  maxConcurrentSessions Int?
  auditRetentionDays    Int
  features              Json
  isActive              Boolean        @default(true)
  displayOrder          Int            @default(0)
  /// Free tier of the freemium funnel. Auto-assigned on signup, never charged.
  isFree                Boolean        @default(false)
  /// Renders as the "most popular" card on the public pricing grid.
  isFeatured            Boolean        @default(false)
  /// Short marketing badge shown on the pricing card, e.g. "Most popular".
  badge                 String?
  /// One-line marketing hook above the feature list.
  tagline               String?
  /// Paid-plan trial length in days. 0 disables the trial.
  trialDays             Int            @default(0)
  /// AI assistant messages included per calendar month. Null means unlimited.
  monthlyAiMessages     Int?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  subscriptions         Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  billingInterval        BillingInterval    @default(MONTHLY)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  cancelAt               DateTime?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id])
  invoices               Invoice[]
}

model Invoice {
  id                String       @id @default(cuid())
  subscriptionId    String
  amountCents       Int
  currency          String       @default("USD")
  status            String       @default("draft")
  providerInvoiceId String?      @unique
  hostedInvoiceUrl  String?      @db.Text
  paidAt            DateTime?
  dueAt             DateTime?
  createdAt         DateTime     @default(now())
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id             String       @id @default(cuid())
  organizationId String
  metric         String
  quantity       Int
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SmtpSetting {
  id                String   @id @default("global")
  host              String
  port              Int
  secure            Boolean  @default(true)
  username          String?
  encryptedPassword String?  @db.Text
  passwordNonce     String?
  passwordAuthTag   String?
  fromEmail         String
  fromName          String
  enabled           Boolean  @default(false)
  testRecipient     String?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedBy         User?    @relation("SmtpUpdatedBy", fields: [updatedById], references: [id])
}

model AppSetting {
  key         String   @id
  category    String
  value       Json
  isSecret    Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id])
}

model PaymentSetting {
  id                     String          @id @default(cuid())
  provider               PaymentProvider
  mode                   String          @default("test")
  publicKey              String?
  encryptedSecretKey     String?         @db.Text
  secretKeyNonce         String?
  secretKeyAuthTag       String?
  encryptedWebhookSecret String?         @db.Text
  webhookSecretNonce     String?
  webhookSecretAuthTag   String?
  enabled                Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([provider, mode])
}

/// Cloudflare Turnstile credentials for the public forms. The site key is public
/// and served to the browser; the secret key is encrypted with the master key.
model TurnstileSetting {
  id                    String   @id @default("global")
  siteKey               String?
  encryptedSecretKey    String?  @db.Text
  secretKeyNonce        String?
  secretKeyAuthTag      String?
  enabled               Boolean  @default(false)
  /// Per-form toggles so admins can protect signup but leave, say, login open.
  protectSignup         Boolean  @default(true)
  protectLogin          Boolean  @default(true)
  protectPasswordReset  Boolean  @default(true)
  protectContact        Boolean  @default(true)
  protectCheckout       Boolean  @default(true)
  protectNewsletter     Boolean  @default(true)
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// OpenAI credentials and behaviour for the in-product AI assistant.
model AiSetting {
  id                 String   @id @default("global")
  provider           String   @default("openai")
  model              String   @default("gpt-4o-mini")
  encryptedApiKey    String?  @db.Text
  apiKeyNonce        String?
  apiKeyAuthTag      String?
  baseUrl            String?
  systemPrompt       String   @db.Text
  temperature        Int      @default(20)
  maxOutputTokens    Int      @default(900)
  /// Fallback monthly per-user message cap when the plan does not set one.
  monthlyMessageCap  Int      @default(100)
  enabled            Boolean  @default(false)
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// One AI assistant conversation. Threads are scoped to an organization so
/// platform admins can review them without cross-tenant leakage.
model AiThread {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  title          String
  archivedAt     DateTime?
  lastMessageAt  DateTime     @default(now())
  messageCount   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AiMessage[]

  @@index([organizationId, lastMessageAt])
  @@index([userId, lastMessageAt])
}

model AiMessage {
  id           String   @id @default(cuid())
  threadId     String
  role         AiRole
  content      String   @db.Text
  model        String?
  promptTokens Int?
  outputTokens Int?
  createdAt    DateTime @default(now())
  thread       AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// A "Contact us" submission from the public site, reviewable in the admin panel.
model ContactMessage {
  id           String        @id @default(cuid())
  name         String
  email        String
  company      String?
  topic        String        @default("general")
  message      String        @db.Text
  status       ContactStatus @default(NEW)
  /// Internal-only notes; never returned to the submitter.
  adminNotes   String?       @db.Text
  ipAddress    String?
  userAgent    String?       @db.Text
  /// Set when a user was signed in at submit time, for support context.
  submittedById String?
  handledById  String?
  handledAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  handledBy    User?         @relation("ContactHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
}

/// Marketing email capture from the public site footer.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String    @default("footer")
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  ipAddress      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// One page view on the public site, written by POST /public/visit.
///
/// Deliberately not an AuditLog: audit rows are organization-scoped and require
/// an actor, while most visits are anonymous and belong to no tenant.
model VisitorLog {
  id        String   @id @default(cuid())
  /// Pathname only — query strings are dropped so the column stays indexable
  /// and cannot accumulate tokens passed in URLs.
  path      String
  referrer  String?  @db.Text
  /// Set when a session cookie accompanied the beacon. Kept on user deletion
  /// as null so traffic history stays intact.
  userId    String?
  ipAddress String?
  userAgent String?  @db.Text
  /// ISO 3166-1 alpha-2, when the edge/proxy supplies a geo header.
  country   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([userId, createdAt])
  @@index([country, createdAt])
}

/// Sign-in lifecycle events. Records the attempted email even when no account
/// matches, which is what makes failed-login review useful.
model AuthEventLog {
  id        String          @id @default(cuid())
  userId    String?
  email     String
  event     AuthEventType
  method    AuthEventMethod
  success   Boolean
  /// Short machine-readable cause on failure, e.g. "invalid_password".
  reason    String?
  ipAddress String?
  userAgent String?         @db.Text
  createdAt DateTime        @default(now())
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([email, createdAt])
}

/// Delivery record for every outbound email.
///
/// Subject and status only — bodies are never stored, because transactional
/// mail carries one-time codes and reset links.
model EmailLog {
  id                String         @id @default(cuid())
  recipient         String
  subject           String
  /// Template identifier, e.g. "password_reset" or "contact_notification".
  kind              String         @default("transactional")
  status            EmailLogStatus
  providerMessageId String?
  error             String?        @db.Text
  createdAt         DateTime       @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([recipient, createdAt])
  @@index([kind, createdAt])
}
