NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Domain / URLs
#
# Production (onshell.cloud):
#   SITE_URL=https://onshell.cloud
#   PUBLIC_BASE_URL=https://onshell.cloud
#   API_BASE_URL=https://onshell.cloud/api
#   GATEWAY_BASE_URL=https://onshell.cloud/gateway
#   CORS_ORIGINS=https://onshell.cloud,https://www.onshell.cloud
#
# One host, with Nginx routing /api and /gateway to the two services. Same
# origin throughout, so the session cookie is first-party and there is no
# cross-site request for a browser to reason about.
#
# The agent defaults to these same URLs (apps/agent/src/config.ts). Change the
# shape here and that default has to move with it, or a freshly installed agent
# will look for an API that is not there.
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
GATEWAY_BASE_URL=http://localhost:4100

# Frontend (browser) copies of the above. Baked into the web bundle at build time.
# Leave blank to auto-derive from SITE_URL / API_BASE_URL / GATEWAY_BASE_URL
# (see apps/web/next.config.mjs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_GATEWAY_BASE_URL=http://localhost:4100

# ---------------------------------------------------------------------------
# Gateway REST authentication.
#
# Set this in production. The gateway's REST API (open/close a session, list a
# directory) is called only by the API service — browsers reach the gateway only
# over the terminal WebSocket, which is keyed by an unguessable session id. With
# this set, every REST route except /health requires `Authorization: Bearer <it>`,
# so /gateway stops answering to anyone who can reach it.
#
# Must be identical for the api and gateway processes. Generate with:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
GATEWAY_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Turnstile escape hatch.
#
# Bot protection is configured from /admin, not here. This flag only exists for
# the lockout case: if "Protect login" is on and the widget will not render (bad
# site key, wrong domain in the Cloudflare dashboard, challenges.cloudflare.com
# blocked), nobody can sign in — including the admin who would go and switch it
# off. Set to true, restart the API, log in, fix the settings, set it back.
# ---------------------------------------------------------------------------
TURNSTILE_DISABLED=false


# Cookie scope. Leave blank to auto-derive the registrable domain from
# PUBLIC_BASE_URL (".onshell.cloud" in production, unset on localhost).
COOKIE_DOMAIN=
# Leave blank. The session cookie is marked Secure based on the actual request
# scheme (X-Forwarded-Proto is honoured when TRUST_PROXY is on). Only set this to
# force the flag when TLS is terminated by a proxy that does not forward the
# scheme — setting "true" while the site is still reachable over http:// makes the
# browser discard the cookie, which looks like a failed login.
COOKIE_SECURE=
# Honour X-Forwarded-* so rate limits and audit logs record the real client IP
# behind Nginx / Cloudflare. Defaults to true in production.
TRUST_PROXY=

DATABASE_URL=mysql://onshell:onshell@localhost:3306/onshell_cloud
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Secrets — REQUIRED in production. The API refuses to boot with these
# placeholders when NODE_ENV=production. Generate real values with:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-development
MASTER_ENCRYPTION_KEY=replace-with-32-byte-base64-key
CORS_ORIGINS=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ---------------------------------------------------------------------------
# Seed admin. ADMIN_PASSWORD is REQUIRED when seeding with NODE_ENV=production;
# outside production the seed generates a random password and prints it once.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@onshell.cloud
ADMIN_PASSWORD=

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@onshell.cloud
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=noreply@onshell.cloud
SMTP_FROM_NAME=Onshell.cloud
# Where "Contact us" submissions are emailed (when SMTP is enabled).
CONTACT_NOTIFY_EMAIL=support@onshell.cloud

PAYMENT_PROVIDER=stripe
PAYMENT_MODE=test
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (bot protection on signup / login / contact / checkout).
#
# These are BOOTSTRAP values only — they seed the database row on first run.
# After that, manage the keys in Admin -> Settings -> Bot Protection, which
# stores the secret key encrypted with MASTER_ENCRYPTION_KEY. The site key is
# served to the browser at runtime by GET /public/site-config, so rotating it
# never needs a rebuild.
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

# ---------------------------------------------------------------------------
# AI assistant (OpenAI). Same pattern: bootstrap only, then manage in
# Admin -> Settings -> AI Assistant. The API key is stored encrypted and is
# never sent to the browser.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: override for Azure OpenAI or an OpenAI-compatible gateway.
OPENAI_BASE_URL=
AI_ASSISTANT_ENABLED=false

MYSQL_DATABASE=onshell_cloud
MYSQL_USER=onshell
MYSQL_PASSWORD=onshell
MYSQL_ROOT_PASSWORD=onshell
