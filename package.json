{
  "name": "onshell-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn turbo build --filter='./packages/*' && yarn turbo dev --parallel",
    "build": "yarn turbo build",
    "lint": "yarn turbo lint",
    "typecheck": "yarn turbo typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "yarn workspace @onshell/api prisma generate",
    "db:migrate": "yarn workspace @onshell/api prisma migrate dev",
    "db:deploy": "yarn workspace @onshell/api prisma migrate deploy",
    "db:seed": "yarn workspace @onshell/api prisma db seed",
    "db:studio": "yarn workspace @onshell/api prisma studio",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-mysql.ps1"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
